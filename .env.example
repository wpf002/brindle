# --- core ---
NODE_ENV="development"
# Which deployment this is: development | staging | production. Separate from
# NODE_ENV on purpose — a staging box is a REAL deployment with real people on
# it, and anything other than "development" refuses to boot on dev stubs
# (self-approving identity checks, a fake payment gateway, emails to stdout).
BRINDLE_ENV="development"
PORT="3001"
CORS_ORIGINS="http://localhost:3010"   # Brindle web app origin(s), comma-separated
WEB_BASE_URL="http://localhost:3010"   # where Stripe/identity redirect back to
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brindle"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-prod"         # REQUIRED in production; the API refuses to boot without a real value

# --- payments (integrated-payment lots: genetics, small lots) ---
STRIPE_SECRET_KEY=""                   # REQUIRED in production; without it the API uses an in-memory fake gateway
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_WEBHOOK_SECRET=""                # signing secret for POST /webhooks/stripe; without it the
                                        # endpoint returns 503 and Connect accounts disabled after
                                        # onboarding go unnoticed until someone refreshes
PLATFORM_FEE_BPS="800"                 # Brindle platform fee in basis points (800 = 8%)

# --- live video ---
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# --- identity verification ---
# Without both PERSONA_* values the API uses a dev provider that self-approves.
# Production boot fails if they're missing.
PERSONA_API_KEY=""
PERSONA_TEMPLATE_ID=""                 # inquiry template configured in the Persona dashboard
PERSONA_WEBHOOK_SECRET=""              # HMAC secret; the webhook rejects unsigned callbacks

# --- back office ---
# There is no shared admin token. Administrator access is a per-user role
# (SUPPORT / OPERATOR / OWNER) granted from a machine with database access:
#   pnpm --filter @brindle/api admin:grant you@ranch.com OWNER
# After the first OWNER exists, everything else is done from the admin console,
# and every change is written to the audit log.

# --- notifications ---
RESEND_API_KEY=""                      # unset = emails are logged to stdout instead of sent
EMAIL_FROM="Brindle <notify@brindle.example>"

# --- media storage (S3 or Cloudflare R2) ---
S3_BUCKET=""
S3_REGION=""                           # "auto" for R2
S3_ENDPOINT=""                         # set for R2 (e.g. https://<acct>.r2.cloudflarestorage.com); blank for AWS S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- market data (USDA AMS) ---
# The LMPR "DataMart" API is free and needs NO key — it's the default source and
# works out of the box. AMS_MMN_API_KEY is only for the separate MyMarketNews
# API (richer feeder-cattle auction reports), which DOES require registration
# at https://mymarketnews.ams.usda.gov/mars-api/getting-started
AMS_DATAMART_BASE="https://mpr.datamart.ams.usda.gov/services/v1.1"
AMS_MMN_API_KEY=""

# --- observability ---
SENTRY_DSN=""                          # unset = errors are structured-logged only

# --- backups ---
BACKUP_DIR="./backups"                 # pnpm --filter @brindle/api backup dumps here, then restores
                                       # the dump into a throwaway database and compares row counts

# --- tuning ---
LOT_CLOSE_SWEEP_MS="30000"             # how often to check for expired timed lots; the sweep takes a
                                       # Redis lease first, so only one instance runs it per tick

# --- web app (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3010"   # used for OG/canonical URLs
NEXT_PUBLIC_MEDIA_BASE_URL=""   # public base URL for uploaded photos (e.g. https://cdn.brindle.example)
