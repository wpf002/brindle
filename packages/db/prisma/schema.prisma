generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────
enum UserType {
  RANCHER
  FEEDLOT
  ORDER_BUYER
  SELLER_BREEDER
  GENETICS_PROVIDER
  SALE_MANAGER
  BUYER
}

enum CreditStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum AuctionFormat {
  LIVE_RING
  TIMED_ONLINE
}

enum SettlementMode {
  CONTRACT
  INTEGRATED_PAYMENT
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  CLOSED
  CANCELLED
}

enum LotCategory {
  STEERS
  HEIFERS
  COWS
  BULLS
  PAIRS
  BRED_HEIFERS
  CALVES
  SEMEN
  EMBRYO
  SHEEP
  GOATS
}

enum PriceUnit {
  CWT
  HEAD
  DOSE
  EMBRYO
}

enum LotStatus {
  DRAFT
  ACTIVE
  SOLD
  PASSED
  WITHDRAWN
}

enum BidKind {
  MANUAL
  PROXY
  FLOOR
  PHONE
}

enum BidStatus {
  ACTIVE
  OUTBID
  WINNING
  RETRACTED
  INVALID
}

enum ContractStatus {
  DRAFT
  SIGNED
  DELIVERED
  SETTLED
  VOID
}

enum PaymentStatus {
  PENDING
  HELD
  CAPTURED
  REFUNDED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_RELEASE
  WITHDRAWN
}

enum DisputeClaim {
  NOT_AS_DESCRIBED
  DELIVERY
  WEIGHT_VARIANCE
  GENETICS_QUALITY
}

enum NotificationType {
  OUTBID
  WINNING
  LOT_WON
  LOT_SOLD
  ENDING_SOON
  PAYMENT_HELD
  DISPUTE_UPDATE
  SYSTEM
}

enum CatalogImportStatus {
  PARSED
  COMMITTED
  FAILED
}

enum DeliveryMethod {
  PICKUP
  SHIPPING
  STORAGE_FACILITY_TRANSFER
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  IN_TRANSIT
  DELIVERED
}

// ──────────────────────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────────────────────
model User {
  id               String       @id @default(uuid())
  type             UserType
  legalName        String
  businessName     String?
  email            String       @unique
  phone            String?
  state            String?
  // buyer credit gate — issued once, used across all sales
  buyerNumber      String?      @unique
  creditStatus     CreditStatus @default(PENDING)
  creditLimitCents BigInt?
  stripeAccountId  String?
  stripeOnboardedAt DateTime?   // Connect Express onboarding completed (charges_enabled)
  idVerifiedAt     DateTime?
  identityRef      String?      // provider inquiry/session id (Persona, Stripe Identity)
  sellerVerified   Boolean      @default(false) // verified-seller badge
  createdAt        DateTime     @default(now())

  // ── credentials (real auth) ──
  passwordHash     String?      // scrypt "salt:hash" hex; null = never set a password (dev-provisioned)
  emailVerifiedAt  DateTime?

  // ── seller story / "behind the brand" profile ──
  title            String?      // e.g. "Owner & General Manager"
  bio              String?
  quote            String?      // pull-quote shown on the seller's story page
  foundedYear      Int?

  auctions         Auction[]    @relation("SellerAuctions")
  bids             Bid[]
  operations       SellerOperation[]
  watchlist        Watchlist[]
  notifications    Notification[]
  catalogImports   CatalogImport[]
}

// A seller's individual ranch properties/divisions — the multi-location story
// ("Dixon Creek", "Frisco Creek") shown on their public profile page.
model SellerOperation {
  id          String  @id @default(uuid())
  sellerId    String
  seller      User    @relation(fields: [sellerId], references: [id])
  name        String
  location    String  // "Guthrie, Texas"
  description String
  acres       Int?
  herdSize    Int?
  sortOrder   Int     @default(0)

  @@index([sellerId, sortOrder])
}

model Auction {
  id              String         @id @default(uuid())
  sellerId        String
  seller          User           @relation("SellerAuctions", fields: [sellerId], references: [id])
  name            String
  format          AuctionFormat
  settlementMode  SettlementMode
  startsAt        DateTime
  endsAt          DateTime?
  streamUrl       String?
  status          AuctionStatus  @default(SCHEDULED)
  buyerPremiumBps Int            @default(0) // basis points (integer)
  softCloseSecs   Int            @default(120)
  termsText       String?
  createdAt       DateTime       @default(now())

  lots            Lot[]
  catalogImports  CatalogImport[]

  @@index([status, startsAt])
}

model Lot {
  id               String      @id @default(uuid())
  auctionId        String
  auction          Auction     @relation(fields: [auctionId], references: [id])
  lotNumber        Int
  category         LotCategory

  // ── live-animal fields ──
  headCount        Int?
  primaryBreed     String?
  breedComposition Json?       // {"angus":75,"hereford":25}
  avgWeightLbs     Decimal?    @db.Decimal(8, 2)
  baseWeightLbs    Decimal?    @db.Decimal(8, 2)
  shrinkPct        Decimal?    @db.Decimal(5, 2)
  slideCents       Int?        // cents/cwt slide adjustment
  bodyCondition    Decimal?    @db.Decimal(3, 1)
  pregStatus       String?
  programCerts     String[]
  originState      String?
  eidTags          String[]

  // ── genetics fields ──
  bullName         String?
  bullRegId        String?
  epd              Json?       // {trait:{value,acc,pct}}
  dosesAvailable   Int?
  postThawMotility Decimal?    @db.Decimal(5, 2)
  storageFacility  String?
  diseaseTests     Json?       // BVD, Trich, Brucellosis, IBR + expiry

  // ── pricing ──
  priceUnit        PriceUnit
  startingBidCents BigInt
  bidIncrementCents BigInt     @default(100) // min raise, in priceUnit cents; required by the sequencer
  reserveCents     BigInt?     // hidden floor
  status           LotStatus   @default(DRAFT)
  photos           String[]
  photoCredit      String?     // "Photo: Peter Robbins"
  videoUrl         String?

  endsAt           DateTime?   // per-lot close (timed sales, soft-close target)
  createdAt        DateTime    @default(now())

  bids             Bid[]
  contract         Contract?
  payment          Payment?
  disputes         Dispute[]
  watchedBy        Watchlist[]
  delivery         Delivery?

  @@unique([auctionId, lotNumber])
}

// A buyer's saved lots — surfaced on their watchlist page and used to target
// outbid/ending-soon notifications.
model Watchlist {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id])
  createdAt DateTime @default(now())

  @@unique([buyerId, lotId])
  @@index([buyerId])
}

// In-app notifications (outbid, won, sold, ending soon, dispute updates).
// Delivery is in-app today; `href` deep-links to the relevant page. Email/SMS
// fan-out is a pluggable adapter (see notify.ts) that no-ops without a real
// provider key configured.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// A bulk catalog upload (CSV/XLSX) a seller ran to create lots in one shot —
// the record of what was parsed, what was committed, and any per-row errors.
model CatalogImport {
  id           String               @id @default(uuid())
  sellerId     String
  seller       User                 @relation(fields: [sellerId], references: [id])
  auctionId    String?
  auction      Auction?             @relation(fields: [auctionId], references: [id])
  filename     String
  status       CatalogImportStatus  @default(PARSED)
  rowCount     Int                  @default(0)
  createdCount Int                  @default(0)
  errorLog     Json?                // [{row, message}]
  createdAt    DateTime             @default(now())
}

// Post-sale logistics for a won lot — pickup/shipping contact and status,
// shared between buyer and seller ("shipping-coordination handoff").
model Delivery {
  id           String         @id @default(uuid())
  lotId        String         @unique
  lot          Lot            @relation(fields: [lotId], references: [id])
  method       DeliveryMethod @default(PICKUP)
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  status       DeliveryStatus @default(PENDING)
  notes        String?
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())
}

model Bid {
  id            String    @id @default(uuid())
  lotId         String
  lot           Lot       @relation(fields: [lotId], references: [id])
  bidderId      String
  bidder        User      @relation(fields: [bidderId], references: [id])
  amountCents   BigInt    // in priceUnit terms
  priceUnit     PriceUnit
  kind          BidKind   @default(MANUAL)
  proxyMaxCents BigInt?
  seq           BigInt    // monotonic per lot, assigned by the sequencer
  streamId      String?   // the ingest-stream entry this bid was sequenced from
  status        BidStatus @default(ACTIVE)
  ip            String?
  createdAt     DateTime  @default(now())

  @@unique([lotId, seq])      // append-only invariant: one bid per (lot, sequence)
  @@unique([lotId, streamId]) // idempotent reprocessing: a stream entry persists at most once
  @@index([lotId, seq])
}

// CONTRACT settlement mode (load lots / breeding stock)
model Contract {
  id                String         @id @default(uuid())
  lotId             String         @unique
  lot               Lot            @relation(fields: [lotId], references: [id])
  buyerId           String
  sellerId          String
  hammerCents       BigInt
  buyerPremiumCents BigInt
  platformFeeCents  BigInt
  baseWeightLbs     Decimal        @db.Decimal(8, 2)
  slideCents        Int
  shrinkPct         Decimal        @db.Decimal(5, 2)
  deliveryWindow    Json           // {start, end}
  status            ContractStatus @default(DRAFT)
  signedAt          DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
}

// Structured dispute claim on a settled lot (INTEGRATED_PAYMENT hold/release).
model Dispute {
  id         String        @id @default(uuid())
  lotId      String
  lot        Lot           @relation(fields: [lotId], references: [id])
  filedById  String
  claim      DisputeClaim
  status     DisputeStatus @default(OPEN)
  detail     String
  evidence   String[] // media keys (presigned uploads)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([status])
}

// Post-transaction ratings — the trust surface.
model Rating {
  id        String   @id @default(uuid())
  raterId   String
  rateeId   String
  lotId     String?
  role      String // which side is being rated: "SELLER" | "BUYER"
  stars     Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  @@index([rateeId])
}

// API keys for third-party integrations + the standalone buyer-intelligence
// surface. Only the SHA-256 hash is stored; the raw key is shown once at creation.
model ApiKey {
  id        String    @id @default(uuid())
  keyHash   String    @unique
  label     String
  scopes    String[] // e.g. ["comparables", "catalog"]
  active    Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

// Editorial content: market reports, sale recaps, ranch news. Platform-authored
// (gated by the same admin token as market-data ingest) — the marketplace's
// editorial voice, not per-seller user-generated posts.
model NewsPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  dek         String    // subhead / excerpt
  body        String    // plain paragraphs, split on blank lines
  category    String    // "Market Report" | "Sale Recap" | "Ranch News"
  authorName  String
  authorTitle String?
  sellerId    String?   // optional tie-in to a seller's sale recap
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([category, publishedAt])
}

// Ingested USDA AMS video/internet auction comps — the bid-box market context.
model MarketReport {
  id             String   @id @default(uuid())
  reportDate     DateTime
  region         String
  category       String // e.g. "STEERS Medium/Large 1"
  wtLowLbs       Int
  wtHighLbs      Int
  avgCentsPerCwt Int // integer cents per hundredweight
  headCount      Int
  source         String // AMS report slug
  createdAt      DateTime @default(now())

  @@unique([source, category, wtLowLbs, wtHighLbs, reportDate])
  @@index([category, wtLowLbs, wtHighLbs, reportDate])
}

// INTEGRATED_PAYMENT settlement mode (genetics / small lots)
model Payment {
  id               String        @id @default(uuid())
  lotId            String        @unique
  lot              Lot           @relation(fields: [lotId], references: [id])
  buyerId          String
  sellerId         String
  amountCents      BigInt
  platformFeeCents BigInt
  stripePaymentId  String?
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
}
